# Copy to api/.env (NOT a repo-root .env) and fill in. api/.env is gitignored.
# database/scripts/06_setup_env.sh can generate a working api/.env for you.
# Full reference: docs/PROJECT_DOCUMENTATION.md -> Configuration.

# ── Database (required) ────────────────────────────────────────
DB_NAME=
DB_USER=nss_db_backend            # read-only role (SELECT only)
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Write role + auth (required for any write/login endpoint) ──
DB_WRITE_USER=nss_db_writer       # SELECT/INSERT/UPDATE, no DELETE/DDL
DB_WRITE_PASSWORD=
JWT_SECRET_KEY=                   # long random string, e.g. python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# ── Optional: token lifetimes (defaults shown) ─────────────────
# JWT_ACCESS_TOKEN_MINUTES=30
# JWT_REFRESH_TOKEN_DAYS=7
# JWT_ABSOLUTE_SESSION_DAYS=30

# ── Optional: connection pools (defaults shown) ────────────────
# DB_READ_POOL_MIN=2
# DB_READ_POOL_MAX=15
# DB_WRITE_POOL_MIN=1
# DB_WRITE_POOL_MAX=5

# ── Optional: HTTP behaviour ───────────────────────────────────
# CORS_ORIGINS=http://localhost:3000,https://erp.example.org   # empty = CORS middleware not registered
# RATE_LIMIT=300/minute
# CSP_ENABLED=true
# CSP_REPORT_ONLY=false
# CSP_SCRIPT_SRC_EXTRA=
# CSP_STYLE_SRC_EXTRA=
# DISABLE_DOCS=false                # true removes Swagger/ReDoc/OpenAPI

# ── Dev only — never set these in a deployed environment ───────
# DEBUG_MODE=false                  # forgot-password echoes the OTP as otp_debug
# DEV_LIVE_RELOAD=false             # frontend auto-reload endpoint + script
