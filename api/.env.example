# Copy to api/.env (NOT a repo-root .env) and fill in. api/.env is gitignored.
# database/scripts/06_setup_env.sh can generate a working api/.env for you.
# Full reference: docs/PROJECT_DOCUMENTATION.md -> Configuration.

# ── Database (required) ────────────────────────────────────────
DB_NAME=
DB_USER=nss_db_backend            # read-only role (SELECT only)
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432

# ── Write role + auth (required for any write/login endpoint) ──
DB_WRITE_USER=nss_db_writer       # SELECT/INSERT/UPDATE, no DELETE/DDL
DB_WRITE_PASSWORD=
JWT_SECRET_KEY=                   # long random string, e.g. python3 -c "import secrets; print(secrets.token_urlsafe(64))"

# ── Aadhaar capture (GDR-011) — needed only to STORE/REVEAL a full number ─
# Generate with: python3 scripts/generate_aadhaar_keys.py   (never reuse, never commit)
# AADHAAR_ENCRYPTION_KEYS=k1:<base64 of 32 random bytes>   # first = active; add "newid:<b64>," in FRONT to rotate, keep old keys after it
# AADHAAR_HASH_PEPPER=<random secret, different from every key>
# AADHAAR_REVEAL_RATE_LIMIT=10/minute      # per signed-in user, GET /person/persons/{pk}/aadhaar only

# ── Optional: token lifetimes (defaults shown) ─────────────────
# JWT_ACCESS_TOKEN_MINUTES=30
# JWT_REFRESH_TOKEN_DAYS=7
# JWT_ABSOLUTE_SESSION_DAYS=30

# ── Optional: connection pools (defaults shown) ────────────────
# DB_READ_POOL_MIN=2
# DB_READ_POOL_MAX=15
# DB_WRITE_POOL_MIN=1
# DB_WRITE_POOL_MAX=5
# DB_POOL_WAIT_SECONDS=20          # a request waits this long for a free pooled connection, then gets a 503
# DB_POOL_PING_AFTER_SECONDS=30   # a connection idle longer than this is tested (SELECT 1) before reuse

# ── Optional: HTTP behaviour ───────────────────────────────────
# CORS_ORIGINS=http://localhost:3000,https://erp.example.org   # empty = CORS middleware not registered
# RATE_LIMIT=300/minute            # global, per client IP
# LIVE_ATTENDANCE_RATE_LIMIT=120/minute   # per signed-in user, attendance /live poll only
# LIVE_CHANGES_RATE_LIMIT=60/minute       # per signed-in user, GET /live/changes (live-refresh feed) only
# ── Optional: UPI collection (Finance, Tier 12) ────────────────
# UPI_GATEWAY_ENABLED_PROVIDERS=            # not set: MOCK,RAZORPAY when DB_HOST is this machine (MOCK = demo, no money moves), otherwise OFF. Set it to override; set it EMPTY to force OFF. On a server: RAZORPAY (never MOCK).
# UPI_REQUEST_EXPIRY_MINUTES=30
# UPI_PAY_RATE_LIMIT=10/minute              # per signed-in user, creating a payment request
# UPI_WEBHOOK_RATE_LIMIT=300/minute         # per IP, the signature-verified gateway webhook
# UPI_WEBHOOK_MAX_BYTES=65536
# UPI_MAX_AMOUNT=100000                    # rupees, per single payment request
# UPI_MIN_AMOUNT=1                         # rupees, smallest single payment request (Razorpay links start at Rs. 1)
# Gateway secrets are per CREDENTIAL SET, named by financial_account.gateway_credential_ref (never stored in the database).
# RAZORPAY (live): the keys from Razorpay Dashboard > Account & Settings > API keys, and the secret you type when you add the webhook
# (Dashboard > Account & Settings > Webhooks, URL https://<your-host>/api/v1/finance/gateway/webhook/razorpay, events: Payment Link Paid / Expired /
# Cancelled). Name the set anything (e.g. RAZORPAY_MAIN), give a receiving account provider RAZORPAY with that credential set name, then:
# UPI_RAZORPAY_MAIN_KEY_ID=rzp_live_xxxxxxxxxxxx
# UPI_RAZORPAY_MAIN_KEY_SECRET=
# UPI_RAZORPAY_MAIN_WEBHOOK_SECRET=
# (UPI_REQUEST_EXPIRY_MINUTES must stay at 16 or more for Razorpay.) The MOCK provider needs no set (built in).
# For any other named set, e.g. SAKHA_A:
# UPI_SAKHA_A_KEY_ID=
# UPI_SAKHA_A_KEY_SECRET=
# UPI_SAKHA_A_WEBHOOK_SECRET=
# CSP_ENABLED=true
# CSP_REPORT_ONLY=false
# CSP_SCRIPT_SRC_EXTRA=
# CSP_STYLE_SRC_EXTRA=
# DISABLE_DOCS=false                # true removes Swagger/ReDoc/OpenAPI

# ── Dev only — never set these in a deployed environment ───────
# DEBUG_MODE=false                  # forgot-password echoes the OTP as otp_debug
# DEV_LIVE_RELOAD=false             # frontend auto-reload endpoint + script
