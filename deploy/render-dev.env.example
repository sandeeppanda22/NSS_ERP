# ======================================================================
# NSS ERP — Render DEV portal environment (template)
# ======================================================================
# Copy to deploy/render-dev.env (gitignored), fill in, then in the Render
# dashboard: Environment -> "Add from .env" and paste it. NEVER commit the
# filled copy.
#
# Layout (decision 2026-11-09): TWO Neon projects, one per environment, each
# with its own roles, passwords, compute and connection limit. Pair:
#   Render PROD service <-> Neon PROD project (the existing nss_erp database)
#   Render DEV  service <-> Neon DEV  project (a new, empty nss_erp database)
# The two files must NOT share any secret: DB passwords, JWT_SECRET_KEY and
# Aadhaar keys all differ. A hard rebuild or a schema-changing deploy on one
# environment never touches the other.
#
# One-time Neon setup for this project (DEV, brand new):
#   1. Create a new Neon project for dev.
#   2. Neon console -> Roles: create role  nss_db_owner  (password = DB_PASSWORD).
#   3. Neon console -> Databases: create database  nss_erp  owned by nss_db_owner.
#      render_build.sh then creates schema nss, the extensions, and the roles
#      nss_db_backend / nss_db_writer (password = DB_WRITE_PASSWORD).
#   4. DB_HOST = the DIRECT endpoint (ep-xxxx.<region>.aws.neon.tech), NOT the
#      "-pooler" one (the build runs DDL; the app sets session variables).
#   5. First deploy: RUN_DB_BOOTSTRAP=true (seeds the admin SS1 / P1 /
#      Admin@123 - change the password immediately), then set it to false.
#   Hard rebuild: see the header of render_build.sh (DROP SCHEMA nss CASCADE).
# ======================================================================

# ── Database (DEV) ────────────────────────────────────────────────
# same name in both projects (render.yaml pins it)
DB_NAME=nss_erp
DB_USER=nss_db_owner
DB_PASSWORD=<DEV owner password - python3 -c "import secrets; print(secrets.token_urlsafe(24))">
DB_HOST=<ep-xxxx-xxxx.region.aws.neon.tech  (DEV project, direct not -pooler)>
DB_PORT=5432
# the variable libpq actually reads (build + app)
PGSSLMODE=require
# not read by any code; kept so the variable set matches the old deployment
DB_SSLMODE=require
# not read by any code; kept for the same reason (libpq's own name is PGCHANNELBINDING)
DB_CHANNEL_BINDING=require

# ── Write role + auth ──────────────────────────────────────────────────
DB_WRITE_USER=nss_db_writer
DB_WRITE_PASSWORD=<DEV writer password - different from DB_PASSWORD and from the other environment>
JWT_SECRET_KEY=<DEV only - python3 -c "import secrets; print(secrets.token_urlsafe(64))">

# ── Build / runtime ────────────────────────────────────────────────────
PYTHON_VERSION=3.14.0
# first deploy of the new empty DEV database only, then false
RUN_DB_BOOTSTRAP=true

# ── Dev conveniences (safe: this database holds test data only) ────────
# Forgot-password OTPs are not delivered anywhere yet (api/routers/auth.py
# TODO); with DEBUG_MODE the reset response echoes the OTP as otp_debug.
DEBUG_MODE=true
# Swagger at /docs on for dev
DISABLE_DOCS=false

# ── Aadhaar (GDR-011) - optional, DEV uses its OWN test keys ───────────
# python3 scripts/generate_aadhaar_keys.py . Never put real Aadhaar numbers
# on DEV. Leave unset to keep capture off (503).
# AADHAAR_ENCRYPTION_KEYS=
# AADHAAR_HASH_PEPPER=

# ── HTTP behaviour (required in this deployment) ───────────────────────
# this DEV service's own URL (same-origin app; only this origin is allowed cross-origin)
CORS_ORIGINS=https://sandy-dev.onrender.com
# global per-IP limit. Do NOT use 60/minute: one dashboard load fans out 20-30 calls and 429s real users (config.py note, 2026-10-27)
RATE_LIMIT=300/minute

# ── Optional tuning (defaults shown; usually leave alone) ──────────────
# DB_READ_POOL_MAX=15              # x2 uvicorn workers; lower on a small Neon compute
# DB_WRITE_POOL_MAX=5

# ── Neon-supplied connection strings (NOT read by the app; it uses DB_* above) ──
# Kept for reference/tools. Real values go only in the gitignored deploy/render-dev.env.
# DATABASE_URL=postgresql://<user>:<password>@<direct-host>/<db>?sslmode=require&channel_binding=require
# DATABASE_URL_POOLED=postgresql://<user>:<password>@<pooler-host>/<db>?sslmode=require&channel_binding=require
