# ======================================================================
# NSS ERP — Render PROD portal environment (template)
# ======================================================================
# Copy to deploy/render-prod.env (gitignored), fill in, then in the Render
# dashboard: Environment -> "Add from .env" and paste it. NEVER commit the
# filled copy.
#
# Layout (decision 2026-11-09): TWO Neon projects, one per environment, each
# with its own roles, passwords, compute and connection limit. Pair:
#   Render PROD service <-> Neon PROD project (the existing nss_erp database)
#   Render DEV  service <-> Neon DEV  project (a new, empty nss_erp database)
# The two files must NOT share any secret: DB passwords, JWT_SECRET_KEY and
# Aadhaar keys all differ. A hard rebuild or a schema-changing deploy on one
# environment never touches the other.
#
# This is the EXISTING Neon project/database (nss_erp). Do not recreate it.
#   - Repoint the Render PROD service here; keep its current DB_* values EXCEPT
#     rotate DB_PASSWORD, DB_WRITE_PASSWORD and JWT_SECRET_KEY if the old ones were
#     ever pasted anywhere (they were shown in a chat session on 2026-11-09).
#     Rotating: reset the nss_db_owner password in the Neon console and run
#     ALTER ROLE nss_db_backend / nss_db_writer PASSWORD '...' (the build never
#     changes an existing role's password).
#   - DB_HOST: prefer the DIRECT endpoint (no "-pooler") for the build.
#   - RUN_DB_BOOTSTRAP stays false: the admin already exists. Set it to true only
#     for a deliberate hard rebuild of prod (render_build.sh header), then back.
#   - Back up (Neon branch/backup) before any schema-changing deploy.
# ======================================================================

# ── Database (PROD) ────────────────────────────────────────────────
# same name in both projects (render.yaml pins it)
DB_NAME=nss_erp
DB_USER=nss_db_owner
DB_PASSWORD=<PROD owner password - python3 -c "import secrets; print(secrets.token_urlsafe(24))">
DB_HOST=<ep-xxxx-xxxx.region.aws.neon.tech  (PROD project, direct not -pooler)>
DB_PORT=5432
# the variable libpq actually reads (build + app)
PGSSLMODE=require
# not read by any code; kept so the variable set matches the old deployment
DB_SSLMODE=require
# not read by any code; kept for the same reason (libpq's own name is PGCHANNELBINDING)
DB_CHANNEL_BINDING=require

# ── Write role + auth ──────────────────────────────────────────────────
DB_WRITE_USER=nss_db_writer
DB_WRITE_PASSWORD=<PROD writer password - different from DB_PASSWORD and from the other environment>
JWT_SECRET_KEY=<PROD only - python3 -c "import secrets; print(secrets.token_urlsafe(64))">

# ── Build / runtime ────────────────────────────────────────────────────
PYTHON_VERSION=3.14.0
# admin already exists; true only for a deliberate hard rebuild
RUN_DB_BOOTSTRAP=false

# ── Hardening ──────────────────────────────────────────────────────────
# hide Swagger/ReDoc/OpenAPI
DISABLE_DOCS=true
# DEBUG_MODE must stay unset/false (it echoes reset OTPs in responses).
# DEV_LIVE_RELOAD must never be set on a deployed environment.

# ── Aadhaar (GDR-011) - leave UNSET until the legal review is done ─────
# Storing Aadhaar numbers is regulated (Aadhaar Act / UIDAI / DPDP). When
# approved: python3 scripts/generate_aadhaar_keys.py (DIFFERENT keys from DEV),
# set both below, and back the keys up OUTSIDE Render - a lost key destroys
# the stored numbers.
# AADHAAR_ENCRYPTION_KEYS=
# AADHAAR_HASH_PEPPER=

# ── UPI payments (Finance) - optional; empty = OFF ─────────────────────
# Do NOT enable MOCK on PROD. RAZORPAY is unverified against the real API.
# Per-Sangha secrets live ONLY here, never in the database: a receiving account
# names a credential set REF and the server reads UPI_<REF>_KEY_ID / _KEY_SECRET
# / _WEBHOOK_SECRET.
# UPI_GATEWAY_ENABLED_PROVIDERS=
# UPI_REQUEST_EXPIRY_MINUTES=30
# UPI_MAX_AMOUNT=100000
# UPI_SAKHA_A_KEY_ID=
# UPI_SAKHA_A_KEY_SECRET=
# UPI_SAKHA_A_WEBHOOK_SECRET=

# ── HTTP behaviour (required in this deployment) ───────────────────────
# this PROD service's own URL (same-origin app; only this origin is allowed cross-origin)
CORS_ORIGINS=<https://your-prod-service.onrender.com>
# global per-IP limit. Do NOT use 60/minute: one dashboard load fans out 20-30 calls and 429s real users (config.py note, 2026-10-27)
RATE_LIMIT=300/minute

# ── Optional tuning (defaults shown; usually leave alone) ──────────────
# DB_READ_POOL_MAX=15              # x2 uvicorn workers; lower on a small Neon compute
# DB_WRITE_POOL_MAX=5
# DB_POOL_WAIT_SECONDS=20          # wait for a free pooled connection before answering 503
# DB_POOL_PING_AFTER_SECONDS=30   # test an idle connection (SELECT 1) before reuse; Neon drops idle ones
